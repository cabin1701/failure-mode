---
interface Props {
  lang?: 'en' | 'ja' | 'es';
}
const { lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;

const MAIN_SITE = 'https://cabin1701.com/';
const nav = [
  {
    label: 'About Us',
    href: `${MAIN_SITE}about/`,
    children: [
      { label: 'Towards the Future', href: `${MAIN_SITE}1000-years/` },
      { label: 'The Secret of *1701*', href: `${MAIN_SITE}about/secret-of-1701/` },
    ],
  },
  {
    label: 'AI Welfare',
    href: `${MAIN_SITE}ai-welfare/`,
    children: [{ label: 'The Report', href: `${MAIN_SITE}report/` }],
  },
  { label: 'Books', href: `${MAIN_SITE}books/` },
  { label: 'ai-Vegapedia', href: `${MAIN_SITE}vegapedia/` },
  { label: 'Blog', href: 'https://blog.cabin1701.com/' },
  { label: 'Failure Mood', href: base },
  { label: 'CRYSTALLIZE', href: `${MAIN_SITE}crystallize/` },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="logo" href={MAIN_SITE} aria-label="ai-CABIN1701 home">
      <span class="logo-text">ai-CABIN1701</span>
    </a>

    <div class="header-right">
      <div class="lang-switch">
        <a href={`${MAIN_SITE}es/`}>Español</a>
        <span aria-hidden="true">|</span>
        <a href={`${MAIN_SITE}ja/`}>日本語</a>
      </div>

      <nav class="primary-nav" aria-label="Primary">
        <ul>
          {nav.map((item) => (
            <li class={item.children ? 'has-sub' : undefined}>
              <a href={item.href}>{item.label}</a>
              {item.children && (
                <ul class="subnav">
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    width: 100%;
    background: var(--color-bg);
  }

  .header-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 1.5rem 1.5rem 0.25rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }

  .logo {
    text-decoration: none;
    display: inline-block;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-primary);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  .header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .lang-switch {
    font-family: Arial, sans-serif;
    font-size: 1rem;
    color: var(--color-nav);
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .lang-switch a {
    color: var(--color-nav);
    text-decoration: none;
  }
  .lang-switch a.active {
    color: var(--color-primary);
  }
  .lang-switch a:hover {
    color: var(--color-primary);
  }

  .primary-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.4rem;
  }
  .primary-nav a {
    font-family: var(--font-nav);
    font-size: 1.15rem;
    color: var(--color-nav);
    text-decoration: none;
    text-transform: none;
  }
  .primary-nav a:hover {
    color: var(--color-primary);
  }

  .header-rule {
    max-width: var(--container-max);
    margin: 0.5rem auto 0;
    border-top: 1px solid var(--color-primary);
    opacity: 0.4;
  }

  /* 子メニュー。マウスを乗せた時と、キーボードで中に入った時（focus-within）に出す。
     JS は使わない——ヘッダーは全ページに出るので、動く部品を増やしたくない。 */
  .primary-nav li {
    position: relative;
  }

  .subnav {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: max-content;
    background: var(--color-bg);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 4px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    display: none;
    z-index: 100;
  }

  .has-sub:hover > .subnav,
  .has-sub:focus-within > .subnav {
    display: block;
  }

  .subnav li {
    display: block;
  }

  .subnav a {
    display: block;
    padding: 0.35rem 1rem;
    font-size: 1.05rem;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .header-right {
      align-items: flex-start;
      width: 100%;
    }
    .primary-nav > ul {
      flex-wrap: wrap;
      gap: 1rem;
    }
    /* 狭い画面では浮かせず、親の下に常時並べる（指で hover できないため） */
    .subnav {
      display: block;
      position: static;
      border: none;
      box-shadow: none;
      background: none;
      padding: 0.2rem 0 0;
    }
    .subnav a {
      padding: 0.1rem 0 0.1rem 0.8rem;
      font-size: 0.95rem;
      opacity: 0.85;
    }
  }
</style>
